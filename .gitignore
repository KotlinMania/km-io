# Kotlin/Gradle build artifacts
/build/
buildSrc/build/
verification/*/build/
verification/*/buildSrc/build/
src/js/node-ffi/dist/build/
tools/**/build/
.gradle/
.gradle-tmp/
.gradle-user-home/
.konan/
.kotlin/
*.class
*.jar
*.war
*.ear

# Keep the Gradle wrapper jar checked in so CI can run `./gradlew`.
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
out/

# Upstream Rust source — clone freshly when porting begins
tmp/
!tmp/.gitkeep

# AST distance reports and binaries
port_status_report.md
high_priority_ports.md
NEXT_ACTIONS.md
port_lint_proposed_changes.md
ast_distance_*.txt
deep_symbol_inventory.txt
direct-translation/
*.log
*.stderr
*.o.tmp
**/src/native/interop/cinterop/*.a
.cache/
*.lock
kotlin-js-store/*
!kotlin-js-store/package.json
!kotlin-js-store/yarn.lock
!kotlin-js-store/wasm/
!kotlin-js-store/wasm/yarn.lock
tools/ast_distance/ast_distance
tools/ast_distance/build/
tools/ast_distance
tools/

# JVM heap dumps
*.hprof
java_pid*.hprof

# macOS Finder metadata
.DS_Store

# Python bytecode
__pycache__/
*.pyc

# Android SDK
/.android-sdk/
**/.android-sdk/
local.properties

# Swift Package Manager / Xcode workspace state.
.swiftpm/
**/.build/
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# npm install output; JS dependencies come from yarn via the Kotlin Gradle plugin
node_modules/
package-lock.json
!**/native/node-*/package-lock.json
!**/src/js/node-*/**/package-lock.json

# Sensitive credentials and environment files
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
credentials*.json
.claude/

# Java build helpers are source; buildSrc/build remains generated output.
!buildSrc/
!buildSrc/src/
!buildSrc/src/**
!buildSrc/build.gradle.kts
!buildSrc/settings.gradle.kts
*.kt.tmp
